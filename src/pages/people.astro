---
import Base from "../layouts/Base.astro";
import Avatar from "../components/Avatar.astro";
import { joinHref } from "../data/site";
import { officers, officersTerm, founders, faculty } from "../data/people";
---

<Base
  title="People"
  description={`Meet the ${officersTerm} officers, founders, and faculty instructors of Pitt AIMs, the University of Pittsburgh's student club for AI in medicine.`}
>
  <header class="page-head sky-head">
    <div class="wrap">
      <p class="eyebrow">People</p>
      <h1>The people who make it happen.</h1>
      <p class="lede">
        Pitt AIMs is run by students, for students, with faculty who teach and mentor alongside
        us.
      </p>
    </div>
  </header>

  <section class="band" aria-labelledby="officers-h">
    <div class="wrap">
      <div class="intro">
        <p class="eyebrow">Officers</p>
        <h2 class="title" id="officers-h">{officersTerm} officers</h2>
      </div>
      <ul class="grid">
        {
          officers.map((p, i) => (
            <li>
              <Avatar person={p} index={i} />
              <p class="name">{p.name}</p>
              {p.role && <p class="role">{p.role}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band white" aria-labelledby="founders-h">
    <div class="wrap">
      <div class="intro">
        <p class="eyebrow">Founders</p>
        <h2 class="title" id="founders-h">Where it started</h2>
        <p class="lede">Pitt AIMs was founded by four Pitt medical students.</p>
      </div>
      <ul class="grid">
        {
          founders.map((p, i) => (
            <li>
              <Avatar person={p} index={i} />
              <p class="name">{p.name}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="faculty-h">
    <div class="wrap">
      <div class="intro">
        <p class="eyebrow">Faculty</p>
        <h2 class="title" id="faculty-h">Faculty and instructors</h2>
        <p class="lede">
          Faculty and staff who have taught in our summer course, Applied Machine Learning in
          Medicine.
        </p>
      </div>
      <ul class="faculty">
        {faculty.map((p) => <li>{p.name}</li>)}
      </ul>
    </div>
  </section>

  <section class="band blue">
    <div class="wrap help">
      <h2 class="title">Want to help run Pitt AIMs?</h2>
      <p class="lede">
        We're always looking for people to lead a journal club, teach a workshop, or mentor a
        project.
      </p>
      <div class="actions"><a class="btn" href={joinHref}>Get in touch</a></div>
    </div>
  </section>
</Base>

<style>
  .sky-head {
    background: var(--sky);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 28px 22px;
  }

  .grid li {
    display: grid;
    align-content: start;
  }

  .name {
    margin-top: 12px;
    font-weight: 800;
    font-stretch: 110%;
    font-size: 18px;
    line-height: 1.2;
  }

  .role {
    font-size: 14.5px;
    color: var(--ink-3);
    margin-top: 2px;
  }

  .faculty {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .faculty li {
    padding: 12px 18px;
    border: 2px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    font-weight: 700;
  }

  .help {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
</style>
