---
import Base from "../layouts/Base.astro";
import Avatar from "../components/Avatar.astro";
import { mailto } from "../data/site";
import {
  officers,
  officersTerm,
  incomingOfficers,
  incomingTerm,
  founders,
  faculty,
} from "../data/people";

const incomingPending = incomingOfficers.some((p) => p.placeholder);
---

<Base
  title="People"
  description={`The officers, founders, and faculty instructors of Pitt AI in Medicine, a student-run club at the University of Pittsburgh.`}
>
  <header class="page-head sky-head">
    <div class="wrap">
      <h1>People</h1>
      <p class="lede">
        The club is run by students, with faculty who teach and mentor alongside us.
      </p>
    </div>
  </header>

  <section class="band white" aria-labelledby="incoming-h">
    <div class="wrap">
      <div class="intro">
        <h2 class="title" id="incoming-h">Incoming officers, {incomingTerm}</h2>
        {
          incomingPending && (
            <p class="lede">
              Announced soon. Interested in a role? <a href={mailto("Officer roles")}>Let us know</a>.
            </p>
          )
        }
      </div>
      <ul class="grid">
        {
          incomingOfficers.map((p, i) => (
            <li>
              <Avatar person={p} index={i} />
              <p class:list={["name", { muted: p.placeholder }]}>{p.name}</p>
              {p.role && <p class="role">{p.role}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="officers-h">
    <div class="wrap">
      <h2 class="title intro" id="officers-h">Officers, {officersTerm}</h2>
      <ul class="grid">
        {
          officers.map((p, i) => (
            <li>
              <Avatar person={p} index={i} />
              <p class="name">{p.name}</p>
              {p.role && <p class="role">{p.role}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band white" aria-labelledby="founders-h">
    <div class="wrap">
      <div class="intro">
        <h2 class="title" id="founders-h">Founders</h2>
        <p class="lede">The club was started by four Pitt medical students.</p>
      </div>
      <ul class="grid">
        {
          founders.map((p, i) => (
            <li>
              <Avatar person={p} index={i} />
              <p class="name">{p.name}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="faculty-h">
    <div class="wrap">
      <div class="intro">
        <h2 class="title" id="faculty-h">Faculty and instructors</h2>
        <p class="lede">
          Faculty and staff who have taught in our summer course, Applied Machine Learning in
          Medicine.
        </p>
      </div>
      <ul class="faculty">
        {faculty.map((p) => <li>{p.name}</li>)}
      </ul>
    </div>
  </section>

  <section class="band blue">
    <div class="wrap help">
      <h2 class="title">Want to help out?</h2>
      <p class="lede">
        We're always looking for people to lead a journal club, teach a workshop, or mentor a
        project.
      </p>
      <div class="actions"><a class="btn" href={mailto("Helping out")}>Get in touch</a></div>
    </div>
  </section>
</Base>

<style>
  .sky-head {
    background: var(--sky);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 28px 22px;
  }

  .grid li {
    display: grid;
    align-content: start;
  }

  .name {
    margin-top: 12px;
    font-weight: 800;
    font-stretch: 110%;
    font-size: 18px;
    line-height: 1.2;
  }

  .name.muted {
    color: var(--ink-3);
    font-weight: 600;
  }

  .role {
    font-size: 14.5px;
    color: var(--ink-3);
    margin-top: 2px;
  }

  .faculty {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .faculty li {
    padding: 12px 18px;
    border: 2px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    font-weight: 700;
  }

  .help {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
</style>
