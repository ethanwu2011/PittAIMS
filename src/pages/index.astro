---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Avatar from "../components/Avatar.astro";
import ForestPlot from "../components/ForestPlot.astro";
import { site, press, joinHref } from "../data/site";
import { course } from "../data/course";
import { officers, officersTerm, incomingTerm, incomingOfficers } from "../data/people";
import { events } from "../data/events";
import { spotlights } from "../data/spotlights";
import { publications, doiUrl } from "../data/publications";

const [featured, ...others] = spotlights;
const isuru = featured.image!;

const activities = [
  {
    icon: "book-open",
    tone: "sky",
    title: "Journal club",
    body: "We pick a recent paper on AI in medicine and talk it through: what they built, whether it holds up, and what it would mean for patients. You don't need to have read every page to show up.",
  },
  {
    icon: "code-xml",
    tone: "gold",
    title: "Coding workshops",
    body: "Hands-on sessions from Python basics to machine learning frameworks and health-data analysis. Bring a laptop. We start from scratch.",
  },
  {
    icon: "graduation-cap",
    tone: "coral",
    title: "Summer ML course",
    body: `${course.title}: ${course.sessions} Friday sessions building real models on the NIH All of Us dataset, ending with your own project.`,
    link: { label: "See the syllabus", href: "/course/" },
  },
  {
    icon: "flask-conical",
    tone: "mint",
    title: "Research projects",
    body: "We connect members with Pitt and UPMC faculty on projects in health records, imaging, language models, and more. Several members have published along the way.",
    link: { label: "Our research", href: "/research/" },
  },
];

const steps = [
  { title: "Say hi", body: "Email us and we'll tell you what's coming up next." },
  { title: "Show up", body: "Come to a journal club or a workshop. No prep or experience needed." },
  { title: "Learn", body: "Take the summer course and build a model on real patient data." },
  { title: "Build", body: "Join a research project with a faculty mentor and see it through." },
];

const faqs = [
  {
    q: "Do I need to know how to code?",
    a: "No. Workshops start from the basics, and the summer course includes a Python and pandas crash course.",
  },
  {
    q: "Do I have to be a Pitt student?",
    a: "No. We're based at Pitt, but anyone curious about AI in medicine is welcome: undergrads, med and grad students, clinicians, engineers, and people from other schools. It's a big tent.",
  },
  {
    q: "When and where do you meet?",
    a: "We're setting this year's schedule now. Email us and we'll send dates and rooms as soon as they're confirmed.",
  },
  {
    q: "Can I actually get published?",
    a: "It happens. Past course projects have been published in peer-reviewed journals, and members publish with faculty at Pitt, UPMC, and beyond. See the research page.",
  },
  {
    q: "What data do we work with?",
    a: "The summer course uses the NIH All of Us Research Program, a national dataset of health records and surveys, through its online Researcher Workbench.",
  },
  {
    q: "How do I get involved?",
    a: `Email ${site.email}. Tell us a little about yourself and what you're interested in, and we'll take it from there.`,
  },
];

const topics = [
  "Journal club",
  "Python workshops",
  "NIH All of Us",
  "Large language models",
  "Graph neural networks",
  "Medical imaging",
  "Interpretable ML",
  "AI ethics",
];
---

<Base>
  <!-- Hero -->
  <section class="hero band blue">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">AI in Medicine Society · University of Pittsburgh</p>
        <h1>A big tent for <span class="scribble">AI in medicine</span>.</h1>
        <p class="lede">
          We're a student-run club at Pitt, and everyone's welcome: med students, undergrads, grad
          students, clinicians, engineers, and the just plain curious, from Pitt or anywhere else.
          Come for journal club and coding workshops, stay for the summer ML course and research
          with Pitt and UPMC faculty.
        </p>
        <div class="actions">
          <a class="btn" href={joinHref}>Join us</a>
          <a class="btn light" href="#what-we-do">See what we do</a>
        </div>
      </div>

      <div class="collage" aria-label="Member research and officers">
        <figure class="snap fig">
          <img src={isuru.src} alt={isuru.alt} width={isuru.width} height={isuru.height} />
          <figcaption>PDGrapher, co-authored by Isuru</figcaption>
        </figure>
        <figure class="snap face one">
          <img src="/images/people/ethan.jpg" alt="Ethan Wu" width="480" height="480" />
          <figcaption>Ethan</figcaption>
        </figure>
        <figure class="snap face two">
          <img src="/images/people/isuru.jpg" alt="Isuru Herath" width="480" height="480" />
          <figcaption>Isuru</figcaption>
        </figure>
        <p class="sticker"><span>No coding experience needed</span></p>
      </div>
    </div>
  </section>

  <!-- Topics ticker -->
  <div class="ticker" aria-label="Topics we cover">
    <div class="track">
      <ul>{topics.map((t) => <li>{t}</li>)}</ul>
      <ul aria-hidden="true">{topics.map((t) => <li>{t}</li>)}</ul>
    </div>
  </div>

  <!-- What we do -->
  <section class="band" id="what-we-do" aria-labelledby="do-h">
    <div class="wrap">
      <div class="intro">
        <p class="eyebrow">What we do</p>
        <h2 class="title" id="do-h">Four ways to get your hands dirty</h2>
      </div>
      <div class="activities">
        {
          activities.map((a) => (
            <article class:list={["activity", a.tone]}>
              <span class="icon">
                <Icon name={a.icon} size={26} />
              </span>
              <h3>{a.title}</h3>
              <p>{a.body}</p>
              {a.link && (
                <a class="more" href={a.link.href}>
                  {a.link.label}
                </a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Events -->
  <section class="band white" id="events" aria-labelledby="events-h">
    <div class="wrap">
      <div class="intro row">
        <div>
          <p class="eyebrow">Coming up</p>
          <h2 class="title" id="events-h">Meetings and events</h2>
          <p class="lede">Dates for this year are still being set. Want them as soon as they're out?</p>
        </div>
        <a class="btn" href={joinHref}>Get updates</a>
      </div>
      <ul class="events">
        {
          events.map((e) => (
            <li class="event">
              <div class:list={["date", { tba: !e.date }]}>
                <span>{e.date ?? "TBA"}</span>
              </div>
              <div class="event-body">
                <p class="kind">{e.kind}</p>
                <h3>{e.title}</h3>
                <p>{e.blurb}</p>
                <p class="when">
                  {[e.time ?? "Time TBA", e.place ?? "Location TBA"].join(" · ")}
                </p>
                {e.link && (
                  <a class="more" href={e.link.href}>
                    {e.link.label}
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Member research -->
  <section class="band white" aria-labelledby="research-h">
    <div class="wrap">
      <div class="intro">
        <p class="eyebrow">Member research</p>
        <h2 class="title" id="research-h">What our members have built</h2>
        <p class="lede">
          Members publish with faculty at Pitt, UPMC, and beyond. A few recent highlights.
        </p>
      </div>

      <article class="feature card">
        <figure class="feature-fig">
          <img src={isuru.src} alt={isuru.alt} width={isuru.width} height={isuru.height} loading="lazy" />
          <figcaption><a href={isuru.creditHref}>{isuru.credit}</a></figcaption>
        </figure>
        <div class="feature-copy">
          <div class="who">
            <Avatar person={{ name: featured.member, photo: featured.photo }} size="sm" />
            <div>
              <p class="who-name">{featured.member}</p>
              <p class="who-role">{featured.role} · {featured.paper.journal}, {featured.paper.year}</p>
            </div>
          </div>
          <h3>{featured.headline}</h3>
          <p class="body">{featured.body}</p>
          <a class="more" href={doiUrl(featured.paper.doi)}>Read the paper</a>
        </div>
      </article>

      <div class="others">
        {
          others.map((s, i) => (
            <article class:list={["card", "spot", i === 0 ? "sky" : "gold"]}>
              <div class="who">
                <Avatar person={{ name: s.member, photo: s.photo }} size="sm" />
                <div>
                  <p class="who-name">{s.member}</p>
                  <p class="who-role">
                    {s.role} · {s.paper.journal}, {s.paper.year}
                  </p>
                </div>
              </div>
              <h3>{s.headline}</h3>
              <p class="body">{s.body}</p>
              {s.member === "Ethan Wu" && (
                <div class="plot-wrap">
                  <ForestPlot
                    figure="Early-onset AMD in All of Us:"
                    rows={[
                      { label: "Hypertension", or: 5.8, lo: 4.25, hi: 7.93 },
                      { label: "Hyperlipidemia", or: 5.16, lo: 3.76, hi: 7.08 },
                      { label: "Rheumatoid arthritis", or: 4.61, lo: 1.55, hi: 13.72 },
                    ]}
                    caption="odds ratio with 95% CI, log scale."
                  />
                </div>
              )}
              <a class="more" href={doiUrl(s.paper.doi)}>
                Read the paper
              </a>
            </article>
          ))
        }
      </div>

      <p class="all">
        <a class="btn light" href="/research/">All {publications.length} member publications</a>
      </p>
    </div>
  </section>

  <!-- How to join -->
  <section class="band sky" id="join" aria-labelledby="join-h">
    <div class="wrap">
      <div class="intro">
        <p class="eyebrow">Get involved</p>
        <h2 class="title" id="join-h">How to join</h2>
        <p class="lede">Four steps, at your own pace.</p>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li>
              <span class="num">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="join-cta"><a class="btn" href={joinHref}>Email us to join</a></p>
    </div>
  </section>

  <!-- Officers -->
  <section class="band" aria-labelledby="officers-h">
    <div class="wrap">
      <div class="intro row">
        <div>
          <p class="eyebrow">The team</p>
          <h2 class="title" id="officers-h">{officersTerm} officers</h2>
        </div>
        <a class="more" href="/people/">Meet everyone</a>
      </div>
      <ul class="officers">
        {
          officers.map((p, i) => (
            <li>
              <Avatar person={p} index={i} />
              <p class="officer-name">{p.name}</p>
              {p.role && <p class="officer-role">{p.role}</p>}
            </li>
          ))
        }
      </ul>
      {
        incomingOfficers.some((p) => p.placeholder) && (
          <p class="incoming">
            <strong>{incomingTerm} officers will be announced soon.</strong> Interested in helping
            run Pitt AIMs? <a href={joinHref}>Let us know</a>.
          </p>
        )
      }
    </div>
  </section>

  <!-- FAQ -->
  <section class="band white" aria-labelledby="faq-h">
    <div class="wrap faq-grid">
      <div>
        <p class="eyebrow">Questions</p>
        <h2 class="title" id="faq-h">Good questions we get a lot</h2>
      </div>
      <div class="faqs">
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Press + CTA -->
  <section class="band blue" aria-labelledby="news-h">
    <div class="wrap news-grid">
      <div>
        <p class="eyebrow" id="news-h">In the news</p>
        {
          press.map((item) => (
            <a class="press" href={item.url}>
              <span class="press-title">“{item.title}”</span>
              <span class="press-outlet">{item.outlet}</span>
            </a>
          ))
        }
      </div>
      <div class="cta">
        <h2 class="title">Come to a meeting.</h2>
        <p class="lede">Bring a friend, bring a laptop, or just bring questions.</p>
        <div class="actions">
          <a class="btn" href={joinHref}>Join us</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding-top: clamp(48px, 7vw, 88px);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }

  @media (min-width: 980px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 48px;
    }
  }

  .hero-copy {
    display: grid;
    gap: 24px;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 5.1vw, 4.1rem);
    font-stretch: 122%;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hero .eyebrow {
    margin-bottom: 0;
  }

  .collage {
    position: relative;
    min-height: 470px;
    max-width: 560px;
    width: 100%;
    justify-self: center;
  }

  .snap {
    position: absolute;
    margin: 0;
    background: var(--white);
    color: var(--navy);
    padding: 10px 10px 8px;
    border: 2px solid var(--navy);
    border-radius: 14px;
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.28);
  }

  .snap img {
    border-radius: 8px;
    width: 100%;
    height: auto;
  }

  .snap figcaption {
    font-size: 13px;
    font-weight: 600;
    padding-top: 6px;
    text-align: center;
  }

  .snap.fig {
    top: 34px;
    left: 0;
    width: 64%;
    transform: rotate(-3deg);
  }

  .snap.face {
    width: 34%;
  }

  .snap.face.one {
    right: 0;
    top: 0;
    transform: rotate(5deg);
  }

  .snap.face.two {
    right: 0;
    bottom: 0;
    transform: rotate(-4deg);
  }

  .sticker {
    position: absolute;
    left: 8%;
    bottom: 0;
    width: 122px;
    height: 122px;
    display: grid;
    place-items: center;
    text-align: center;
    border-radius: 50%;
    background: var(--gold);
    color: var(--navy);
    border: 2px solid var(--navy);
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.28);
    transform: rotate(-12deg);
    font-weight: 800;
    font-stretch: 115%;
    font-size: 15px;
    line-height: 1.1;
    padding: 18px;
  }

  @media (max-width: 560px) {
    .collage {
      min-height: 370px;
    }

    .sticker {
      width: 104px;
      height: 104px;
      font-size: 12.5px;
      padding: 14px;
    }
  }

  /* Ticker */
  .ticker {
    background: var(--gold);
    border-block: 2px solid var(--navy);
    overflow: hidden;
    white-space: nowrap;
  }

  .ticker .track {
    display: flex;
    width: max-content;
    animation: ticker 40s linear infinite;
  }

  .ticker ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ticker li {
    padding: 14px 0;
    font-weight: 800;
    font-stretch: 118%;
    font-size: 17px;
    color: var(--navy);
  }

  .ticker li::after {
    content: "✦";
    margin: 0 22px;
    color: var(--blue);
  }

  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  /* Activities */
  .activities {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 680px) {
    .activities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .activities {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .activity {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px 24px;
    border: 2px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--pop);
  }

  .activity.sky {
    background: var(--sky);
  }

  .activity.gold {
    background: var(--gold-soft);
  }

  .activity.coral {
    background: var(--coral-soft);
  }

  .activity.mint {
    background: var(--mint);
  }

  .activity .icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--white);
    border: 2px solid var(--line);
    color: var(--blue);
  }

  .activity h3 {
    font-size: 1.4rem;
    margin-top: 6px;
  }

  .activity p {
    color: var(--ink-2);
    font-size: 16px;
    flex: 1;
  }

  .activity .more {
    color: var(--navy);
  }

  /* Research */
  .feature {
    display: grid;
    gap: 28px;
    padding: 0;
    overflow: hidden;
    box-shadow: var(--pop);
  }

  @media (min-width: 900px) {
    .feature {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0;
    }
  }

  .feature-fig {
    margin: 0;
    background: var(--white);
    padding: 24px;
    display: grid;
    align-content: center;
    gap: 10px;
    border-bottom: 2px solid var(--line);
  }

  @media (min-width: 900px) {
    .feature-fig {
      border-bottom: 0;
      border-right: 2px solid var(--line);
    }
  }

  .feature-fig figcaption {
    font-size: 12.5px;
    color: var(--ink-3);
  }

  .feature-fig figcaption a {
    color: inherit;
  }

  .feature-copy {
    padding: 0 26px 28px;
    display: grid;
    align-content: center;
    gap: 14px;
    background: var(--sky-soft);
  }

  @media (min-width: 900px) {
    .feature-copy {
      padding: 36px;
    }
  }

  .feature h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .who {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .who :global(.avatar) {
    width: 52px;
    flex: none;
  }

  .who-name {
    font-weight: 800;
    font-stretch: 110%;
  }

  .who-role {
    font-size: 14px;
    color: var(--ink-3);
  }

  .body {
    color: var(--ink-2);
  }

  .others {
    display: grid;
    gap: 20px;
    margin-top: 20px;
  }

  @media (min-width: 900px) {
    .others {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  .spot {
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: var(--pop);
  }

  .spot.sky {
    background: var(--sky-soft);
  }

  .spot.gold {
    background: #fff4d6;
  }

  .spot h3 {
    font-size: 1.35rem;
  }

  .spot .body {
    flex: 1;
  }

  .plot-wrap {
    background: var(--white);
    border: 2px solid var(--line);
    border-radius: 14px;
    padding: 16px 16px 12px;
  }

  .all {
    margin-top: 32px;
  }

  /* Steps */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    counter-reset: step;
  }

  @media (min-width: 760px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .steps li {
    background: var(--white);
    border: 2px solid var(--line);
    border-radius: var(--radius);
    padding: 22px 22px 24px;
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .num {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--gold);
    border: 2px solid var(--navy);
    font-weight: 800;
    font-size: 20px;
    margin-bottom: 6px;
  }

  .steps h3 {
    font-size: 1.3rem;
  }

  .steps p {
    color: var(--ink-2);
    font-size: 16px;
  }

  .join-cta {
    margin-top: 32px;
  }

  /* Events */
  .events {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  @media (min-width: 760px) {
    .events {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .event {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 18px;
    padding: 20px;
    border: 2px solid var(--line);
    border-radius: var(--radius);
    background: var(--cream);
  }

  .date {
    display: grid;
    place-items: center;
    align-self: start;
    aspect-ratio: 1;
    border: 2px solid var(--line);
    border-radius: 16px;
    background: var(--gold);
    font-weight: 800;
    font-stretch: 118%;
    font-size: 17px;
    line-height: 1.1;
    text-align: center;
    padding: 6px;
  }

  .date.tba {
    background: var(--white);
    border-style: dashed;
    color: var(--ink-3);
  }

  .event-body {
    display: grid;
    align-content: start;
    gap: 6px;
  }

  .kind {
    font-size: 12.5px;
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .event h3 {
    font-size: 1.25rem;
  }

  .event p:not(.kind) {
    color: var(--ink-2);
    font-size: 16px;
  }

  .event .when {
    font-size: 14px !important;
    color: var(--ink-3) !important;
  }

  .event .more {
    font-size: 15px;
  }

  /* Officers */
  .intro.row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 12px 24px;
    max-width: none;
  }

  .officers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 24px 20px;
  }

  .officer-name {
    margin-top: 12px;
    font-weight: 800;
    font-stretch: 110%;
    font-size: 17px;
    line-height: 1.2;
  }

  .officer-role {
    font-size: 14px;
    color: var(--ink-3);
  }

  .incoming {
    margin-top: 28px;
    padding: 16px 20px;
