---
import Base from "../layouts/Base.astro";
import PublicationList from "../components/PublicationList.astro";
import { mailto } from "../data/site";
import { publications } from "../data/publications";

const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);
const since = Math.min(...years);
---

<Base
  title="Publications"
  description={`${publications.length} papers by Pitt AI in Medicine members on machine learning, large language models, and AI in medicine, with links to each paper.`}
>
  <header class="page-head sky-head">
    <div class="wrap">
      <h1>Publications</h1>
      <p class="lede">
        {publications.length} papers by members since {since}, newest first. Member names are
        highlighted. Published something we missed? <a href={mailto("Publication to add")}>Send us
        the DOI</a>.
      </p>
    </div>
  </header>

  <section class="band">
    <div class="wrap">
      {
        years.map((y) => (
          <section class="year" aria-labelledby={`y${y}`}>
            <h2 class="year-h" id={`y${y}`}>
              {y}
            </h2>
            <PublicationList items={publications.filter((p) => p.year === y)} hideYear />
          </section>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .sky-head {
    background: var(--sky);
  }

  .year + .year {
    margin-top: 48px;
  }

  .year-h {
    display: inline-block;
    font-size: 16px;
    font-stretch: 115%;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--navy);
    color: var(--white);
    margin-bottom: 16px;
  }
</style>
