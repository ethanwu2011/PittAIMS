---
import Base from "../layouts/Base.astro";
import Avatar from "../components/Avatar.astro";
import PublicationList from "../components/PublicationList.astro";
import { site } from "../data/site";
import { publications, doiUrl } from "../data/publications";
import { spotlights } from "../data/spotlights";

const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);
const [featured, ...others] = spotlights;

const steps = [
  {
    title: "Question",
    body: "A clinician or faculty mentor brings a question worth answering: who gets this disease early, what predicts a bad outcome, what are we missing.",
  },
  {
    title: "Data",
    body: "Members define cases and controls and build the dataset, often in the NIH All of Us Researcher Workbench.",
  },
  {
    title: "Model",
    body: "Start with models you can explain, like logistic regression and gradient-boosted trees, and test them on held-out data.",
  },
  {
    title: "Paper",
    body: "Check the findings against the clinical literature, then write it up for peer review with your mentor.",
  },
];

const pitchHref = `mailto:${site.email}?subject=${encodeURIComponent("Project idea for Pitt AIMs")}`;
const joinProjectHref = `mailto:${site.email}?subject=${encodeURIComponent("Joining a Pitt AIMs project")}`;
---

<Base
  title="Research"
  description="Research by Pitt AIMs members: graph neural networks for drug discovery, machine learning on NIH All of Us health records, large language models in pathology, and more."
>
  <header class="page-head gold-head">
    <div class="wrap">
      <p class="eyebrow">Research</p>
      <h1>Members doing real research.</h1>
      <p class="lede">
        Members work with faculty at Pitt, UPMC, and beyond, on everything from drug discovery to
        health records to language models. Here's some of what they've published.
      </p>
    </div>
  </header>

  <section class="band white" aria-labelledby="spot-h">
    <div class="wrap">
      <div class="intro">
        <p class="eyebrow">Spotlight</p>
        <h2 class="title" id="spot-h">{featured.headline}</h2>
      </div>
      <div class="spot-main">
        <figure class="overview card">
          <img
            src="/images/research/pdgrapher-overview.jpg"
            alt="PDGrapher overview: diseased and healthy gene expression go into the model, which predicts drug targets and how they would shift the cell toward a treated state."
            width="1612"
            height="1148"
            loading="lazy"
          />
          <figcaption>
            PDGrapher overview.{" "}
            {featured.image && <a href={featured.image.creditHref}>{featured.image.credit}</a>}
          </figcaption>
        </figure>
        <div class="spot-copy">
          <div class="who">
            <Avatar person={{ name: featured.member, photo: featured.photo }} size="sm" />
            <div>
              <p class="who-name">{featured.member}</p>
              <p class="who-role">{featured.role}</p>
            </div>
          </div>
          <p>{featured.body}</p>
          <p class="cite">
            <a href={doiUrl(featured.paper.doi)}>{featured.paper.title}</a>
            <span>{featured.paper.journal}, {featured.paper.year}</span>
          </p>
        </div>
      </div>

      <div class="others">
        {
          others.map((s, i) => (
            <article class:list={["card", "other", i === 0 ? "sky" : "gold"]}>
              <div class="who">
                <Avatar person={{ name: s.member, photo: s.photo }} size="sm" />
                <div>
                  <p class="who-name">{s.member}</p>
                  <p class="who-role">{s.role}</p>
                </div>
              </div>
              <h3>{s.headline}</h3>
              <p class="body">{s.body}</p>
              <p class="cite">
                <a href={doiUrl(s.paper.doi)}>{s.paper.title}</a>
                <span>
                  {s.paper.journal}, {s.paper.year}
                </span>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band sky" aria-labelledby="how-h">
    <div class="wrap">
      <div class="intro">
        <p class="eyebrow">How it works</p>
        <h2 class="title" id="how-h">From a question to a paper</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li>
              <span class="num">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band" id="publications" aria-labelledby="pubs-h">
    <div class="wrap">
      <div class="intro">
        <p class="eyebrow">Publications</p>
        <h2 class="title" id="pubs-h">Member publications</h2>
        <p class="lede">Selected work by Pitt AIMs members, whose names are in bold.</p>
      </div>
      {
        years.map((y) => (
          <div class="year">
            <h3 class="year-h">{y}</h3>
            <PublicationList items={publications.filter((p) => p.year === y)} hideYear />
          </div>
        ))
      }
    </div>
  </section>

  <section class="band blue" aria-labelledby="collab-h">
    <div class="wrap two">
      <div>
        <h2 class="title" id="collab-h">Faculty: bring us a question</h2>
        <p class="lede">
          Have a clinical question and the data, or a route to it? We have members who want to do
          the work. Send us a paragraph and we'll find the right people.
        </p>
        <div class="actions"><a class="btn" href={pitchHref}>Pitch a project</a></div>
      </div>
      <div>
        <h2 class="title">Want to join a project?</h2>
        <p class="lede">
          The fastest way in is the <a href="/course/">summer course</a>, which ends with a project
          of your own. Or email us with what you're curious about.
        </p>
        <div class="actions"><a class="btn light" href={joinProjectHref}>Email us</a></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .gold-head {
    background: var(--gold-soft);
  }

  .spot-main {
    display: grid;
    gap: 28px;
    align-items: start;
  }

  @media (min-width: 980px) {
    .spot-main {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 40px;
    }
  }

  .overview {
    margin: 0;
    padding: 16px;
    box-shadow: var(--pop);
  }

  .overview img {
    width: 100%;
    height: auto;
  }

  .overview figcaption {
    margin-top: 10px;
    font-size: 13px;
    color: var(--ink-3);
  }

  .overview figcaption a {
    color: inherit;
  }

  .spot-copy {
    display: grid;
    gap: 18px;
    color: var(--ink-2);
    font-size: 17.5px;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .who :global(.avatar) {
    width: 56px;
    flex: none;
  }

  .who-name {
    font-weight: 800;
    font-stretch: 110%;
    color: var(--ink);
  }

  .who-role {
    font-size: 14px;
    color: var(--ink-3);
  }

  .cite {
    display: grid;
    gap: 2px;
    font-size: 15px;
  }

  .cite a {
    font-weight: 700;
  }

  .cite span {
    color: var(--ink-3);
  }

  .others {
    display: grid;
    gap: 20px;
    margin-top: 40px;
  }

  @media (min-width: 900px) {
    .others {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  .other {
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: var(--pop);
  }

  .other.sky {
    background: var(--sky-soft);
  }

  .other.gold {
    background: #fff4d6;
  }

  .other h3 {
    font-size: 1.35rem;
  }

  .other .body {
    color: var(--ink-2);
    flex: 1;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }

  @media (min-width: 760px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .steps li {
    background: var(--white);
    border: 2px solid var(--line);
    border-radius: var(--radius);
    padding: 22px;
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .num {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--gold);
    border: 2px solid var(--navy);
    font-weight: 800;
    font-size: 20px;
    margin-bottom: 6px;
  }

  .steps h3 {
    font-size: 1.3rem;
  }

  .steps p {
    color: var(--ink-2);
    font-size: 16px;
  }

  .year + .year {
    margin-top: 40px;
  }

  .year-h {
    display: inline-block;
    font-size: 15px;
    font-stretch: 115%;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--navy);
    color: var(--white);
    margin-bottom: 16px;
  }

  .two {
    display: grid;
    gap: 48px;
  }

  @media (min-width: 900px) {
    .two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .two > div {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .two .title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .two .lede a {
    color: var(--gold);
  }
</style>
