---
import Base from "../layouts/Base.astro";
import Avatar from "../components/Avatar.astro";
import PersonChip from "../components/PersonChip.astro";
import PipelineCard from "../components/PipelineCard.astro";
import PublicationList from "../components/PublicationList.astro";
import { mailto } from "../data/site";
import { publications, doiUrl } from "../data/publications";
import { person } from "../data/people";
import { spotlights } from "../data/spotlights";
import { groups, pipeline } from "../data/research";

const byDoi = new Map(publications.map((p) => [p.doi, p]));
const papersFor = (dois: string[] = []) =>
  dois.map((doi) => {
    const p = byDoi.get(doi);
    if (!p) throw new Error(`research.ts lists a DOI that isn't in publications.ts: ${doi}`);
    return p;
  });

const groupName = new Map(groups.map((g) => [g.id, g.name]));
for (const item of pipeline) {
  if (!groupName.has(item.group)) throw new Error(`Unknown research group "${item.group}" on "${item.title}"`);
}

const [featured, ...others] = spotlights;
const SHOWN = 3;

const steps = [
  {
    title: "Question.",
    body: "A clinician or faculty mentor brings a question worth answering, like who gets a disease early or what predicts a bad outcome.",
  },
  {
    title: "Data.",
    body: "Members figure out which patients to study and build the dataset, from sources like NIH All of Us or MIMIC.",
  },
  {
    title: "Analysis.",
    body: "We start with methods we can explain, and check the results on patients the model hasn't seen.",
  },
  {
    title: "Share it.",
    body: "An abstract at a meeting, a paper, or a tool people can use, written up with the mentor.",
  },
];
---

<Base
  title="Research"
  description="Research by Pitt AI in Medicine members: what's coming out, highlights, and research groups in clinical prediction, critical care, neurosurgery, drug discovery, OB/GYN, pathology, and more."
>
  <header class="page-head gold-head">
    <div class="wrap">
      <h1>Research</h1>
      <p class="lede">
        Members do research with faculty at Pitt, UPMC, and other schools, in AI and well beyond it:
        papers, conference abstracts, and tools people can use. Join a group below, or start your
        own.
      </p>
      <nav class="group-nav" aria-label="Research groups">
        {groups.map((g) => <a class="gchip" href={`#${g.id}`}>{g.name}</a>)}
      </nav>
    </div>
  </header>

  <section class="band white" aria-labelledby="coming-h">
    <div class="wrap">
      <div class="intro">
        <h2 class="title" id="coming-h">Coming out</h2>
        <p class="lede">Work that's under review, submitted, or about to launch.</p>
      </div>
      <ul class="pipeline">
        {
          pipeline.map((item) => (
            <li class:list={{ wide: !!item.image }}>
              <PipelineCard item={item} />
            </li>
          ))
        }
        <li>
          <a class="add" href={mailto("Something coming out")}>
            <span class="add-h">Got something coming out?</span>
            <span>A paper, poster, abstract, or tool. Tell us and we'll add it here.</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="highlights-h">
    <div class="wrap">
      <h2 class="title intro" id="highlights-h">Highlights</h2>

      <article class="spot-main">
        <figure class="overview card">
          <img
            src="/images/research/pdgrapher-overview.jpg"
            alt="PDGrapher overview: diseased and healthy gene expression go into the model, which predicts drug targets and how they would shift the cell toward a treated state."
            width="1612"
            height="1148"
            loading="lazy"
          />
          <figcaption>
            PDGrapher overview.{" "}
            {featured.image && <a href={featured.image.creditHref}>{featured.image.credit}</a>}
          </figcaption>
        </figure>
        <div class="spot-copy">
          <div class="who">
            <Avatar person={{ name: featured.member, photo: featured.photo }} size="sm" />
            <div>
              <p class="who-name">{featured.member}</p>
              <p class="who-role">{featured.role}</p>
            </div>
          </div>
          <h3>{featured.headline}</h3>
          <p>{featured.body}</p>
          <p class="cite">
            <a href={doiUrl(featured.paper.doi)}>{featured.paper.title}</a>
            <span>{featured.paper.journal}, {featured.paper.year}</span>
          </p>
        </div>
      </article>

      <div class="others">
        {
          others.map((s, i) => (
            <article class:list={["card", "other", i % 2 === 0 ? "mint" : "sky"]}>
              <div class="who">
                <Avatar person={person(s.member)} index={i} size="sm" />
                <div>
                  <p class="who-name">{s.member}</p>
                  <p class="who-role">{s.role}</p>
                </div>
              </div>
              <h3>{s.headline}</h3>
              <p class="body">{s.body}</p>
              <p class="cite">
                <a href={doiUrl(s.paper.doi)}>{s.paper.title}</a>
                <span>
                  {s.paper.journal}, {s.paper.year}
                </span>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band white" aria-labelledby="groups-h">
    <div class="wrap">
      <div class="intro">
        <h2 class="title" id="groups-h">Research groups</h2>
        <p class="lede">Who's working on what. Papers are examples, not a complete record.</p>
      </div>

      <div class="groups">
        {
          groups.map((g) => {
            const papers = papersFor(g.papers);
            const upcoming = pipeline.filter((item) => item.group === g.id);
            return (
              <section class="group" id={g.id} aria-labelledby={`${g.id}-h`}>
                <header class:list={["group-head", g.tone]}>
                  <h3 id={`${g.id}-h`}>{g.name}</h3>
                  <p>{g.blurb}</p>
                  <div class="people">
                    {g.people.map((n, i) => (
                      <PersonChip name={n} index={i} />
                    ))}
                  </div>
                </header>

                <div class="group-body">
                  {upcoming.length > 0 && (
                    <ul class="upcoming">
                      {upcoming.map((item) => (
                        <li>
                          <span class="pill">{item.status}</span> {item.title}
                        </li>
                      ))}
                    </ul>
                  )}

                  {g.abstracts?.map((a) => (
                    <div class="abstract">
                      <p class="abs-kind">Conference abstracts</p>
                      <p class="abs-title">{a.title ?? `Abstracts at the ${a.meeting}`}</p>
                    </div>
                  ))}

                  {papers.length > 0 && <PublicationList items={papers.slice(0, SHOWN)} />}

                  {papers.length > SHOWN && (
                    <details class="more-papers">
                      <summary>More papers from this group</summary>
                      <PublicationList items={papers.slice(SHOWN)} />
                    </details>
                  )}

                  {upcoming.length === 0 && !g.abstracts && papers.length === 0 && (
                    <p class="empty">Work in progress. Check back soon.</p>
                  )}
                </div>
              </section>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="band sky" aria-labelledby="how-h">
    <div class="wrap two-col">
      <h2 class="title" id="how-h">How projects usually go</h2>
      <ol class="steps">
        {
          steps.map((s) => (
            <li>
              <strong>{s.title}</strong> {s.body}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band blue" aria-labelledby="collab-h">
    <div class="wrap two">
      <div>
        <h2 class="title" id="collab-h">Faculty: bring us a question</h2>
        <p class="lede">
          Have a clinical question and the data, or a route to it? We have members who want to do
          the work. Send us a paragraph and we'll find the right people.
        </p>
        <div class="actions"><a class="btn" href={mailto("Project idea")}>Pitch a project</a></div>
      </div>
      <div>
        <h2 class="title">Want to join a group?</h2>
        <p class="lede">
          Email us with what you're curious about and we'll connect you. The <a href="/course/"
            >summer course</a
          > is also a good way in, since it ends with a project of your own.
        </p>
        <div class="actions">
          <a class="btn light" href={mailto("Joining a research group")}>Email us</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .gold-head {
    background: var(--gold-soft);
  }

  .group-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .gchip {
    padding: 8px 14px;
    border: 2px solid var(--line);
    border-radius: 999px;
    font-weight: 700;
    font-size: 15px;
    color: var(--navy);
    text-decoration: none;
    background: var(--white);
  }

  .gchip:hover {
    background: var(--sky);
  }

  /* Coming out */
  .pipeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }

  @media (min-width: 900px) {
    .pipeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pipeline .wide {
      grid-column: 1 / -1;
    }
  }

  .add {
    display: grid;
    align-content: center;
    gap: 6px;
    height: 100%;
    min-height: 160px;
    padding: 24px;
    border: 2px dashed var(--line);
    border-radius: var(--radius);
    color: var(--ink-2);
    text-decoration: none;
  }

  .add:hover {
    background: var(--sky-soft);
  }

  .add-h {
    font-weight: 800;
    font-stretch: 108%;
    font-size: 1.2rem;
    color: var(--navy);
  }

  /* Highlights */
  .spot-main {
    display: grid;
    gap: 28px;
    align-items: start;
  }

  @media (min-width: 980px) {
    .spot-main {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 40px;
    }
  }

  .overview {
    margin: 0;
    padding: 16px;
  }

  .overview img {
    width: 100%;
    height: auto;
  }

  .overview figcaption {
    margin-top: 10px;
    font-size: 13px;
    color: var(--ink-3);
  }

  .overview figcaption a {
    color: inherit;
  }

  .spot-copy {
    display: grid;
    gap: 16px;
    color: var(--ink-2);
    font-size: 17.5px;
  }

  .spot-copy h3 {
    color: var(--ink);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .who {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .who :global(.avatar) {
    width: 56px;
    flex: none;
  }

  .who-name {
    font-weight: 800;
    font-stretch: 110%;
    color: var(--ink);
  }

  .who-role {
    font-size: 14px;
    color: var(--ink-3);
  }

  .cite {
    display: grid;
    gap: 2px;
    font-size: 15px;
  }

  .cite a {
    font-weight: 700;
  }

  .cite span {
    color: var(--ink-3);
  }

  .others {
    display: grid;
    gap: 20px;
    margin-top: 28px;
  }

  @media (min-width: 900px) {
    .others {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  .other {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .other.sky {
    background: var(--sky-soft);
  }

  .other.mint {
    background: #e6f8ef;
  }

  .other h3 {
    font-size: 1.35rem;
  }

  .other .body {
    color: var(--ink-2);
  }

  /* Groups */
  .groups {
    display: grid;
    gap: 28px;
  }

  .group {
    border: 2px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    overflow: hidden;
    scroll-margin-top: 96px;
  }

  .group-head {
    display: grid;
    gap: 10px;
    padding: clamp(20px, 3vw, 28px);
    border-bottom: 2px solid var(--line);
  }

  .group-head.sky {
    background: var(--sky);
  }

  .group-head.gold {
    background: var(--gold-soft);
  }

  .group-head.coral {
    background: var(--coral-soft);
  }

  .group-head.mint {
    background: var(--mint);
  }

  .group-head h3 {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
  }

  .group-head p {
    color: var(--ink-2);
    max-width: 70ch;
  }

  .people {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }

  .group-body {
    display: grid;
    gap: 16px;
    padding: clamp(18px, 3vw, 28px);
    background: var(--cream);
  }

  .upcoming {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-weight: 700;
  }

  .pill {
    display: inline-block;
    margin-right: 6px;
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--gold);
    border: 2px solid var(--line);
    font-size: 12.5px;
    font-weight: 800;
  }

  .abstract {
    background: var(--white);
    border: 2px dashed var(--line);
    border-radius: 18px;
    padding: 16px 20px;
    display: grid;
    gap: 4px;
  }

  .abs-kind {
    font-size: 13px;
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .abs-title {
    font-weight: 800;
    font-stretch: 104%;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .more-papers summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--blue);
    padding: 4px 0 12px;
  }

  .empty {
    color: var(--ink-3);
  }

  /* How it goes */
  .two-col {
    display: grid;
    gap: 24px;
  }

  @media (min-width: 900px) {
    .two-col {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: 56px;
    }
  }

  .steps {
    margin: 0;
    padding-left: 1.4em;
    display: grid;
    gap: 14px;
    font-size: 17.5px;
    color: var(--ink-2);
  }

  .steps li::marker {
    font-weight: 800;
    color: var(--blue);
  }

  .steps strong {
    color: var(--ink);
  }

  /* CTA */
  .two {
    display: grid;
    gap: 48px;
  }

  @media (min-width: 900px) {
    .two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .two > div {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .two .title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .two .lede a {
    color: var(--gold);
  }
</style>
