---
import Base from "../layouts/Base.astro";
import PublicationList from "../components/PublicationList.astro";
import { site } from "../data/site";
import { publications } from "../data/publications";

const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);

const steps = [
  {
    title: "Question",
    body: "A clinician or faculty mentor brings a question worth answering: who gets this disease early, what predicts a bad outcome, what are we missing.",
  },
  {
    title: "Cohort",
    body: "Students define cases and matched controls and build the dataset, most often in the NIH All of Us Researcher Workbench.",
  },
  {
    title: "Model",
    body: "Interpretable models first: logistic regression, gradient-boosted trees, clustering. Evaluated on held-out data with AUC and feature attributions.",
  },
  {
    title: "Paper",
    body: "We check findings against the clinical literature, validate where we can, and write it up for peer review with our mentors.",
  },
];
---

<Base
  title="Research"
  description="Publications and research projects from Pitt AIMs: interpretable machine learning on real patient data, run by students with Pitt and UPMC faculty."
>
  <header class="page-head">
    <div class="wrap">
      <p class="label">Research</p>
      <h1>Student research, published.</h1>
      <p class="lede">
        Our members run machine learning projects on real clinical data with faculty at Pitt and
        UPMC. We favor models a clinician can interrogate, and questions a clinician actually has.
      </p>
    </div>
  </header>

  <section class="section" aria-labelledby="method-h">
    <div class="wrap section-grid">
      <p class="label"><span class="num">01</span> Method</p>
      <div>
        <h2 class="section-title" id="method-h">How a project runs</h2>
        <ol class="steps">
          {
            steps.map((s, i) => (
              <li>
                <span class="step-num">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section" id="publications" aria-labelledby="pubs-h">
    <div class="wrap section-grid">
      <p class="label"><span class="num">02</span> Publications</p>
      <div>
        <h2 class="section-title" id="pubs-h">Publications</h2>
        <p class="note">Selected work by Pitt AIMs members, whose names are in bold. Newest first.</p>
        {
          years.map((y) => (
            <div class="year">
              <h3 class="year-h">{y}</h3>
              <PublicationList items={publications.filter((p) => p.year === y)} hideYear />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section collab" aria-labelledby="collab-h">
    <div class="wrap section-grid">
      <p class="label"><span class="num">03</span> Collaborate</p>
      <div class="two">
        <div>
          <h2 class="section-title" id="collab-h">Bring us a question</h2>
          <p class="prose">
            Faculty and clinicians: if you have a question and the data, or a route to it, we have
            students who want to do the work. Tell us the question in a paragraph and we'll find
            the right people.
          </p>
          <p class="more">
            <a class="btn" href={`mailto:${site.email}?subject=Project%20idea%20for%20Pitt%20AIMs`}>
              Pitch a project
            </a>
          </p>
        </div>
        <div>
          <h2 class="section-title">Join a project</h2>
          <p class="prose">
            Students: the fastest way in is the <a href="/course/">summer course</a>, which ends
            with a project of your own. You can also email us with what you're interested in and
            any experience you have. None is fine.
          </p>
          <p class="more">
            <a class="btn ghost" href={`mailto:${site.email}?subject=Joining%20a%20Pitt%20AIMs%20project`}>
              Email us
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding: clamp(40px, 6vw, 80px) 0 clamp(36px, 5vw, 64px);
  }

  .page-head .wrap {
    display: grid;
    gap: 20px;
  }

  .page-head h1 {
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 450;
    max-width: 18ch;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
  }

  .steps li {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--rule);
  }

  .step-num {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-3);
    padding-top: 5px;
  }

  .steps h3 {
    font-size: 1.3rem;
    margin-bottom: 4px;
  }

  .steps p {
    color: var(--ink-2);
    max-width: 64ch;
  }

  @media (min-width: 760px) {
    .steps li {
      grid-template-columns: 64px 160px minmax(0, 1fr);
    }

    .steps li > div {
      display: contents;
    }

    .steps h3 {
      margin: 0;
    }
  }

  .note {
    color: var(--ink-3);
    margin-bottom: 28px;
  }

  .year + .year {
    margin-top: 40px;
  }

  .year-h {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 4px;
  }

  .collab {
    background: var(--paper-2);
  }

  .two {
    display: grid;
    gap: 48px;
  }

  @media (min-width: 900px) {
    .two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .two .section-title {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .more {
    margin-top: 20px;
  }
</style>
