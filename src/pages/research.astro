---
import Base from "../layouts/Base.astro";
import Avatar from "../components/Avatar.astro";
import PublicationList from "../components/PublicationList.astro";
import { mailto } from "../data/site";
import { publications, doiUrl } from "../data/publications";
import { spotlights } from "../data/spotlights";

const [featured, ...others] = spotlights;

const steps = [
  {
    title: "Question.",
    body: "A clinician or faculty mentor brings a question worth answering, like who gets a disease early or what predicts a bad outcome.",
  },
  {
    title: "Data.",
    body: "Members define cases and controls and build the dataset, often in the NIH All of Us Researcher Workbench.",
  },
  {
    title: "Model.",
    body: "We start with models we can explain, like logistic regression and gradient-boosted trees, and test them on held-out data.",
  },
  {
    title: "Paper.",
    body: "We check the findings against the clinical literature and write it up for peer review with the mentor.",
  },
];

const latest = publications.slice(0, 5);
---

<Base
  title="Research"
  description="Research by Pitt AI in Medicine members: graph neural networks for drug discovery, machine learning on NIH All of Us health records, large language models in pathology, and more."
>
  <header class="page-head gold-head">
    <div class="wrap">
      <h1>Research</h1>
      <p class="lede">
        Members work with faculty at Pitt, UPMC, and elsewhere on everything from drug discovery to
        health records to language models. A few recent projects are below, and the full list is on
        the <a href="/publications/">publications page</a>.
      </p>
    </div>
  </header>

  <section class="band white" aria-labelledby="spot-h">
    <div class="wrap">
      <h2 class="title intro" id="spot-h">{featured.headline}</h2>
      <div class="spot-main">
        <figure class="overview card">
          <img
            src="/images/research/pdgrapher-overview.jpg"
            alt="PDGrapher overview: diseased and healthy gene expression go into the model, which predicts drug targets and how they would shift the cell toward a treated state."
            width="1612"
            height="1148"
            loading="lazy"
          />
          <figcaption>
            PDGrapher overview.{" "}
            {featured.image && <a href={featured.image.creditHref}>{featured.image.credit}</a>}
          </figcaption>
        </figure>
        <div class="spot-copy">
          <div class="who">
            <Avatar person={{ name: featured.member, photo: featured.photo }} size="sm" />
            <div>
              <p class="who-name">{featured.member}</p>
              <p class="who-role">{featured.role}</p>
            </div>
          </div>
          <p>{featured.body}</p>
          <p class="cite">
            <a href={doiUrl(featured.paper.doi)}>{featured.paper.title}</a>
            <span>{featured.paper.journal}, {featured.paper.year}</span>
          </p>
        </div>
      </div>

      <div class="others">
        {
          others.map((s, i) => (
            <article class:list={["card", "other", i === 0 ? "sky" : "gold"]}>
              <div class="who">
                <Avatar person={{ name: s.member, photo: s.photo }} size="sm" />
                <div>
                  <p class="who-name">{s.member}</p>
                  <p class="who-role">{s.role}</p>
                </div>
              </div>
              <h3>{s.headline}</h3>
              <p class="body">{s.body}</p>
              <p class="cite">
                <a href={doiUrl(s.paper.doi)}>{s.paper.title}</a>
                <span>
                  {s.paper.journal}, {s.paper.year}
                </span>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band sky" aria-labelledby="how-h">
    <div class="wrap two-col">
      <h2 class="title" id="how-h">How projects usually go</h2>
      <ol class="steps">
        {
          steps.map((s) => (
            <li>
              <strong>{s.title}</strong> {s.body}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band" aria-labelledby="pubs-h">
    <div class="wrap">
      <div class="intro row">
        <h2 class="title" id="pubs-h">Latest publications</h2>
        <a class="more" href="/publications/">All {publications.length} publications</a>
      </div>
      <PublicationList items={latest} />
    </div>
  </section>

  <section class="band blue" aria-labelledby="collab-h">
    <div class="wrap two">
      <div>
        <h2 class="title" id="collab-h">Faculty: bring us a question</h2>
        <p class="lede">
          Have a clinical question and the data, or a route to it? We have members who want to do
          the work. Send us a paragraph and we'll find the right people.
        </p>
        <div class="actions"><a class="btn" href={mailto("Project idea")}>Pitch a project</a></div>
      </div>
      <div>
        <h2 class="title">Want to join a project?</h2>
        <p class="lede">
          The fastest way in is the <a href="/course/">summer course</a>, which ends with a project
          of your own. Or email us with what you're curious about.
        </p>
        <div class="actions"><a class="btn light" href={mailto("Joining a project")}>Email us</a></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .gold-head {
    background: var(--gold-soft);
  }

  .spot-main {
    display: grid;
    gap: 28px;
    align-items: start;
  }

  @media (min-width: 980px) {
    .spot-main {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 40px;
    }
  }

  .overview {
    margin: 0;
    padding: 16px;
  }

  .overview img {
    width: 100%;
    height: auto;
  }

  .overview figcaption {
    margin-top: 10px;
    font-size: 13px;
    color: var(--ink-3);
  }

  .overview figcaption a {
    color: inherit;
  }

  .spot-copy {
    display: grid;
    gap: 18px;
    color: var(--ink-2);
    font-size: 17.5px;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .who :global(.avatar) {
    width: 56px;
    flex: none;
  }

  .who-name {
    font-weight: 800;
    font-stretch: 110%;
    color: var(--ink);
  }

  .who-role {
    font-size: 14px;
    color: var(--ink-3);
  }

  .cite {
    display: grid;
    gap: 2px;
    font-size: 15px;
  }

  .cite a {
    font-weight: 700;
  }

  .cite span {
    color: var(--ink-3);
  }

  .others {
    display: grid;
    gap: 20px;
    margin-top: 40px;
  }

  @media (min-width: 900px) {
    .others {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  .other {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .other.sky {
    background: var(--sky-soft);
  }

  .other.gold {
    background: #fff4d6;
  }

  .other h3 {
    font-size: 1.35rem;
  }

  .other .body {
    color: var(--ink-2);
    flex: 1;
  }

  .two-col {
    display: grid;
    gap: 24px;
  }

  @media (min-width: 900px) {
    .two-col {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: 56px;
    }
  }

  .steps {
    margin: 0;
    padding-left: 1.4em;
    display: grid;
    gap: 14px;
    font-size: 17.5px;
    color: var(--ink-2);
  }

  .steps li::marker {
    font-weight: 800;
    color: var(--blue);
  }

  .steps strong {
    color: var(--ink);
  }

  .intro.row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
    max-width: none;
  }

  .two {
    display: grid;
    gap: 48px;
  }

  @media (min-width: 900px) {
    .two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .two > div {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .two .title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .two .lede a {
    color: var(--gold);
  }
</style>
