---
import { site, nav, press } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="about">
      <p class="wordmark">Pitt AIMs</p>
      <p class="blurb">
        A student-led research group at the University of Pittsburgh School of Medicine using machine
        learning to answer clinical questions.
      </p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>

    <nav aria-label="Footer">
      <p class="head">Site</p>
      <ul>
        <li><a href="/">Home</a></li>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/#join">Get involved</a></li>
      </ul>
    </nav>

    <div>
      <p class="head">In the news</p>
      <ul>
        {
          press.map((item) => (
            <li>
              <a href={item.url}>{item.outlet}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="wrap fine">
    <p>© {year} {site.fullName}. A student organization at the University of Pittsburgh.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    background: var(--paper-2);
    padding: 48px 0 28px;
    font-size: 15px;
  }

  .grid {
    display: grid;
    gap: 32px;
  }

  @media (min-width: 760px) {
    .grid {
      grid-template-columns: 2fr 1fr 1.4fr;
      gap: 48px;
    }
  }

  .wordmark {
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .blurb {
    color: var(--ink-2);
    max-width: 44ch;
    margin-bottom: 12px;
  }

  .head {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 10px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  ul a {
    color: var(--ink-2);
    text-decoration: none;
  }

  ul a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .fine {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    font-size: 13px;
    color: var(--ink-3);
  }
</style>
