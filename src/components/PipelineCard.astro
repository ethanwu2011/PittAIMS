---
import PersonChip from "./PersonChip.astro";
import type { PipelineItem } from "../data/research";

interface Props {
  item: PipelineItem;
  /** Hide the image (used on the homepage). */
  compact?: boolean;
}

const { item, compact = false } = Astro.props;
const showImage = item.image && !compact;
---

<article class:list={["pipe", { wide: showImage }]}>
  {
    showImage && (
      <figure class="pic">
        <img
          src={item.image!.src}
          alt={item.image!.alt}
          width={item.image!.width}
          height={item.image!.height}
          loading="lazy"
        />
      </figure>
    )
  }
  <div class="copy">
    <p class="status">{item.status}</p>
    <h3>{item.title}</h3>
    <p class="body">{item.body}</p>
    <div class="people">
      {item.people.map((n, i) => <PersonChip name={n} index={i} />)}
      {item.andOthers && <span class="others">and others</span>}
    </div>
    {
      item.links && (
        <p class="links">
          {item.links.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </p>
      )
    }
  </div>
</article>

<style>
  .pipe {
    display: grid;
    height: 100%;
    border: 2px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .pipe.wide {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
  }

  .pic {
    margin: 0;
    padding: 16px;
    display: grid;
    align-items: center;
    border-bottom: 2px solid var(--line);
  }

  @media (min-width: 900px) {
    .wide .pic {
      border-bottom: 0;
      border-right: 2px solid var(--line);
    }
  }

  .pic img {
    width: 100%;
    height: auto;
  }

  .copy {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: clamp(18px, 2.6vw, 26px);
  }

  .wide .copy {
    align-content: center;
  }

  .status {
    justify-self: start;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--gold);
    border: 2px solid var(--line);
    font-size: 13px;
    font-weight: 800;
    font-stretch: 110%;
  }

  h3 {
    font-size: clamp(1.2rem, 2vw, 1.45rem);
  }

  .body {
    color: var(--ink-2);
  }

  .people {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .others {
    font-weight: 600;
    color: var(--ink-2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-weight: 700;
    font-size: 15.5px;
  }
</style>
