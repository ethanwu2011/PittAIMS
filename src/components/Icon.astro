---
// Inline Lucide icon (ISC license) by name, e.g. <Icon name="book-open" />.
// Add a name to the braces to make another icon available.
const icons = import.meta.glob<string>(
  "/node_modules/lucide-static/icons/{book-open,code-xml,graduation-cap,flask-conical,arrow-up-right}.svg",
  {
    query: "?raw",
    import: "default",
    eager: true,
  },
);

interface Props {
  name: string;
  size?: number;
}

const { name, size = 24 } = Astro.props;
const raw = icons[`/node_modules/lucide-static/icons/${name}.svg`];
if (!raw) throw new Error(`Unknown icon: ${name}`);
const svg = raw
  .replace(/<!--.*?-->/s, "")
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace("<svg", '<svg aria-hidden="true" focusable="false"');
---

<Fragment set:html={svg} />
