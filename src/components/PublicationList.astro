---
import { authorParts, doiUrl, type Publication } from "../data/publications";

interface Props {
  items: Publication[];
  /** Compact rows for the homepage: no summary or tags. */
  compact?: boolean;
  /** Omit the year when the list is already grouped by year. */
  hideYear?: boolean;
}

const { items, compact = false, hideYear = false } = Astro.props;
---

<ol class:list={["pubs", { compact }]}>
  {
    items.map((p) => (
      <li>
        <p class="venue">
          {!hideYear && `${p.year} · `}
          <cite>{p.journal}</cite>
        </p>
        <h3>
          <a href={doiUrl(p.doi)}>{p.title}</a>
        </h3>
        <p class="authors">
          {authorParts(p).map((a, i) => (
            <>
              {i > 0 && ", "}
              {a.elided && "… "}
              {a.member ? <strong>{a.name}</strong> : a.name}
            </>
          ))}
        </p>
        {!compact && <p class="summary">{p.summary}</p>}
        {!compact && (
          <div class="foot">
            <div class="tags">
              {p.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
            <p class="ids">
              <a href={doiUrl(p.doi)}>doi:{p.doi}</a>
              {p.pmid && (
                <>
                  {" · "}
                  <a href={`https://pubmed.ncbi.nlm.nih.gov/${p.pmid}/`}>PMID {p.pmid}</a>
                </>
              )}
            </p>
          </div>
        )}
      </li>
    ))
  }
</ol>

<style>
  .pubs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .pubs > li {
    background: var(--white);
    border: 2px solid var(--line);
    border-radius: var(--radius);
    padding: 20px 22px;
  }

  .venue {
    font-size: 13px;
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--blue);
  }

  cite {
    font-style: normal;
  }

  .pubs h3 {
    font-size: clamp(1.1rem, 1.8vw, 1.28rem);
    font-stretch: 104%;
    line-height: 1.3;
    margin: 6px 0;
  }

  .pubs h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .pubs h3 a:hover {
    color: var(--blue);
    text-decoration: underline;
  }

  .authors {
    font-size: 14.5px;
    color: var(--ink-3);
  }

  .authors strong {
    color: var(--ink);
    font-weight: 700;
    background: var(--gold-soft);
    padding: 0 3px;
    border-radius: var(--radius);
  }

  .summary {
    margin-top: 10px;
    color: var(--ink-2);
    max-width: 72ch;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 20px;
    margin-top: 14px;
  }

  .ids {
    font-size: 13px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .ids a {
    color: var(--ink-3);
  }

  .ids a:hover {
    color: var(--blue);
  }

  .compact > li {
    padding: 16px 18px;
  }
</style>
