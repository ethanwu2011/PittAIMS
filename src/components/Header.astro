---
import { nav } from "../data/site";

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Pitt AIMs home">
      <span class="wordmark">Pitt AIMs</span>
      <span class="sub">AI in Medicine Society</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a class="cta" href="/#join">Get involved</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 24px;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 12px;
    color: var(--ink);
    text-decoration: none;
  }

  .wordmark {
    font-family: var(--serif);
    font-size: 23px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .sub {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  ul {
    display: flex;
    align-items: center;
    gap: 4px 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    padding: 4px 0;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }

  nav a[aria-current="page"] {
    box-shadow: inset 0 -2px 0 var(--gold);
  }

  .cta {
    color: var(--ink);
    border: 1px solid var(--rule-strong);
    padding: 7px 12px;
  }

  .cta:hover {
    border-color: var(--ink);
  }

  @media (max-width: 720px) {
    .sub {
      display: none;
    }

    .bar {
      padding-top: 10px;
      padding-bottom: 10px;
    }

    ul {
      gap: 16px;
    }

    .cta {
      padding: 5px 9px;
    }
  }

  @media (max-width: 420px) {
    nav {
      width: 100%;
    }

    ul {
      justify-content: space-between;
    }
  }
</style>
