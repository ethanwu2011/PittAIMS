---
// Forest plot of odds ratios with 95% CIs on a log scale. Built from HTML
// rather than SVG so the text stays legible at phone widths.

interface Row {
  label: string;
  or: number;
  lo: number;
  hi: number;
}

interface Props {
  figure: string;
  rows: Row[];
  caption: string;
  source: { label: string; href: string };
  min?: number;
  max?: number;
}

const { figure, rows, caption, source, min = 0.5, max = 16 } = Astro.props;

const ticks = [0.5, 1, 2, 4, 8, 16].filter((t) => t >= min && t <= max);
const pos = (x: number) => ((Math.log(x) - Math.log(min)) / (Math.log(max) - Math.log(min))) * 100;
const fmt = (x: number) => x.toFixed(2);
---

<figure class="forest">
  <div class="plot" role="img" aria-label={caption}>
    {
      rows.map((r) => (
        <div class="row">
          <div class="name">
            <span>{r.label}</span>
            <span class="val">
              OR {fmt(r.or)} ({fmt(r.lo)}–{fmt(r.hi)})
            </span>
          </div>
          <div class="track">
            <span class="null" style={`left:${pos(1)}%`} />
            <span class="ci" style={`left:${pos(r.lo)}%;width:${pos(r.hi) - pos(r.lo)}%`} />
            <span class="pt" style={`left:${pos(r.or)}%`} />
          </div>
        </div>
      ))
    }
    <div class="row axis" aria-hidden="true">
      <div class="name"><span class="val">Odds ratio</span></div>
      <div class="track">
        {
          ticks.map((t) => (
            <span class="tick" style={`left:${pos(t)}%`}>
              {t}
            </span>
          ))
        }
      </div>
    </div>
  </div>
  <figcaption>
    <span class="fig">{figure}</span>
    {caption}{" "}
    <a href={source.href}>{source.label}</a>
  </figcaption>
</figure>

<style>
  .forest {
    margin: 0;
    border: 1px solid var(--rule);
    background: var(--paper);
    padding: 22px 22px 18px;
  }

  .plot {
    display: grid;
    gap: 6px;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(8.5rem, 38%) minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    min-height: 52px;
  }

  .name {
    display: grid;
    font-size: 14.5px;
    line-height: 1.3;
  }

  .val {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .track {
    position: relative;
    height: 100%;
    min-height: 34px;
  }

  .null {
    position: absolute;
    top: -6px;
    bottom: -6px;
    border-left: 1px dashed var(--rule-strong);
  }

  .ci {
    position: absolute;
    top: 50%;
    height: 2px;
    background: var(--plot-ink);
    transform: translateY(-50%);
  }

  .ci::before,
  .ci::after {
    content: "";
    position: absolute;
    top: -5px;
    height: 12px;
    border-left: 2px solid var(--plot-ink);
  }

  .ci::before {
    left: 0;
  }

  .ci::after {
    right: 0;
  }

  .pt {
    position: absolute;
    top: 50%;
    width: 13px;
    height: 13px;
    background: var(--gold);
    border: 2px solid var(--plot-ink);
    transform: translate(-50%, -50%);
  }

  .axis {
    min-height: 30px;
    border-top: 1px solid var(--rule);
    padding-top: 6px;
  }

  .axis .track {
    min-height: 20px;
  }

  .tick {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-3);
  }

  .tick::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -7px;
    height: 5px;
    border-left: 1px solid var(--rule-strong);
  }

  figcaption {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .fig {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--ink);
    margin-right: 6px;
  }

  @media (max-width: 480px) {
    .forest {
      padding: 16px 14px 14px;
    }

    .row {
      gap: 10px;
      grid-template-columns: minmax(8.5rem, 44%) minmax(0, 1fr);
    }

    .val {
      font-size: 11px;
    }
  }
</style>
