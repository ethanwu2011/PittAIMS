---
import PersonChip from "./PersonChip.astro";
import type { Tool } from "../data/research";

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<article class:list={["tool", { wide: tool.image }]}>
  {
    tool.image && (
      <a class="shot" href={tool.url}>
        <img
          src={tool.image.src}
          alt={tool.image.alt}
          width={tool.image.width}
          height={tool.image.height}
          loading="lazy"
        />
      </a>
    )
  }
  <div class="copy">
    <p class="kind">Tool</p>
    <h3>{tool.name}: {tool.tagline}</h3>
    <p class="body">{tool.body}</p>
    {tool.status && <p class="status">{tool.status}</p>}
    <div class="people">{tool.people.map((n, i) => <PersonChip name={n} index={i} />)}</div>
    <p class="links">
      <a class="more" href={tool.url}>{tool.linkLabel}</a>
      {tool.code && <a href={tool.code}>Source code</a>}
    </p>
  </div>
</article>

<style>
  .tool {
    display: grid;
    border: 2px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    overflow: hidden;
  }

  .tool.wide {
    background: var(--mint);
  }

  @media (min-width: 900px) {
    .tool.wide {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    }
  }

  .shot {
    display: grid;
    align-items: center;
    padding: 12px;
    background: var(--white);
    border-bottom: 2px solid var(--line);
  }

  @media (min-width: 900px) {
    .shot {
      border-bottom: 0;
      border-right: 2px solid var(--line);
    }
  }

  .shot img {
    width: 100%;
    height: auto;
  }

  .copy {
    display: grid;
    align-content: center;
    gap: 12px;
    padding: clamp(20px, 3vw, 32px);
  }

  .kind {
    font-size: 13px;
    font-weight: 700;
    color: var(--blue);
  }

  h3 {
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
  }

  .body {
    color: var(--ink-2);
  }

  .status {
    font-size: 14px;
    color: var(--ink-3);
  }

  .people {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 15.5px;
  }

  .links a:not(.more) {
    font-weight: 600;
  }
</style>
